{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheTracker",
  "version": "0.9.5",
  "identifier": "dev.lilcham1.thetracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TheTracker",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://cdn.cloudflare.steamstatic.com https://assets-bucket.deadlock-api.com https://avatars.steamstatic.com data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "WebView2Loader.dll"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5MEE1M0QwRDc0MzIwMjAKUldRZ0lFUFgwRk1LbWJUazJIcW55cENpYjc0d1Q5bGdYMVBDVDZ1ZHhYTDdPMXpSckdhUjBIZ2wK",
      "endpoints": [
        "https://github.com/lilcham1/TheTracker/releases/latest/download/latest.json"
      ]
    }
  }
}
