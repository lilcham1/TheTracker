{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dota Tracker",
  "version": "0.4.0",
  "identifier": "dev.lilcham1.dotatracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dota Tracker",
        "width": 480,
        "height": 840,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://cdn.cloudflare.steamstatic.com https://assets-bucket.deadlock-api.com https://avatars.steamstatic.com data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
